<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="sensor_cfg"
                  value="${xacro.load_yaml('$(find robot_description)/config/sensor_mount.yaml')}"/>

  <xacro:macro name="mmwave_unit" params="name cfg">
    <joint name="${name}_joint" type="fixed">
      <parent link="${cfg['parent']}"/>
      <child link="${name}_link"/>
      <origin xyz="${cfg['xyz'][0]} ${cfg['xyz'][1]} ${cfg['xyz'][2]}"
              rpy="${cfg['rpy'][0]} ${cfg['rpy'][1]} ${cfg['rpy'][2]}"/>
    </joint>

    <link name="${name}_link">
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
      <visual>
        <geometry>
          <box size="0.04 0.06 0.03"/>
        </geometry>
        <material name="mmwave_purple">
          <color rgba="0.69 0.49 1.0 1.0"/>
        </material>
      </visual>
    </link>

    <gazebo reference="${name}_link">
      <sensor type="ray" name="${name}_sensor">
        <always_on>1</always_on>
        <update_rate>${cfg['update_rate']}</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>${cfg['h_samples']}</samples>
              <resolution>1</resolution>
              <min_angle>${-cfg['h_fov']/2.0}</min_angle>
              <max_angle>${cfg['h_fov']/2.0}</max_angle>
            </horizontal>
            <vertical>
              <samples>3</samples>
              <resolution>1</resolution>
              <min_angle>${-cfg['v_fov']/2.0}</min_angle>
              <max_angle>${cfg['v_fov']/2.0}</max_angle>
            </vertical>
          </scan>
          <range>
            <min>${cfg['range_min']}</min>
            <max>${cfg['range_max']}</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <plugin name="${name}_ray" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <namespace>/robot</namespace>
            <remapping>~/out:=${cfg['topic']}</remapping>
          </ros>
          <output_type>sensor_msgs/PointCloud2</output_type>
          <frame_name>${cfg['frame']}</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>

</robot>
